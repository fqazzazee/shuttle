/bin/
/build/
/shuttle
dist/
coverage/
coverage.out
coverage.html
*.test
*.out
*.log

# go.work is ignored for a single module
go.work
go.work.sum

# The extension's lint tooling: package.json and package-lock.json say what
/node_modules/

# Local scratch (.cache/ holds the Samba test share)
tmp/
.tmp/
.cache/

# AI agent instructions, skills and planning notes stay on the maintainer's
# machine. People who run the software don't need them.
