.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Secrets — never relax these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
credentials.json
secrets.yaml

