    <string name="force_stopped_text">shuttle was force-stopped, so nothing synced until you opened it. Syncing has started again.</string>
    <string name="ok">OK</string>
    <string name="perm_heading">Before you start</string>
    <string name="perm_intro">shuttle needs three permissions to sync. You can give them now or later; until you do, the shuttles that need one wait and say which.</string>
    <string name="perm_files">All files access</string>
    <string name="perm_files_why">To read and write the folders you sync in the phone\'s storage. Without it, shuttles with a folder there wait, and nothing in them is synced or deleted.</string>
    <string name="perm_network">Local network access</string>
    <string name="perm_network_why">To reach your NAS or other computers on your network. Without it, Android lets those connections time out, and shuttles with a share there wait.</string>
    <string name="perm_notifications">Notifications</string>
    <string name="perm_notifications_why">To tell you about errors, conflicts and finished syncs, and to show while syncing runs. Without them, shuttle still syncs, silently.</string>
